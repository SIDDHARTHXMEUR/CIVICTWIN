{
  "name": "civictwin",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "cd apps/api && mvnw.cmd spring-boot:run",
